# Production web server (image: Dockerfile; stack: the backend repo's deploy/compose.yaml).
# Serves the SPA and proxies the API on the same origin, so there's no CORS and the
# SameSite=Strict refresh cookie works. TLS certificates come from Let's Encrypt.
{
	email {$ACME_EMAIL}
}

{$DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	@backend path /api/* /oauth2/* /login/oauth2/* /actuator/health /actuator/health/*
	handle @backend {
		reverse_proxy api:8080
	}

	handle {
		root * /srv
		# Hashed bundles never change; index.html and the rest must be revalidated.
		@hashed path_regexp ^/[^/]+-[0-9A-Za-z_-]{8}\.(js|css)$
		header @hashed Cache-Control "public, max-age=31536000, immutable"
		@unhashed not path_regexp ^/[^/]+-[0-9A-Za-z_-]{8}\.(js|css)$
		header @unhashed Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
